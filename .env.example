# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (UI model dropdown also lets you pick at runtime)
# STUDYCARDS_DB_PATH=data/studycards.db
# STUDYCARDS_PROVIDER=anthropic
# STUDYCARDS_MODEL=claude-sonnet-5
#
# Model IDs move fast. Leave STUDYCARDS_MODEL unset to let the app pick its
# curated default, or use the sidebar dropdown, which lists the models your
# key can actually reach.
